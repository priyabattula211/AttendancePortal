{
  "name": "attendance-portal",
  "version": "1.0.0",
  "private": true,
  "description": "MITRA attendance portal monorepo",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "concurrently -k -n frontend,backend -c blue,green \"npm run frontend\" \"npm run backend\"",
    "frontend": "npm --workspace frontend run dev",
    "backend": "npm --workspace backend run dev",
    "build": "npm --workspace frontend run build",
    "lint": "npm --workspace frontend run lint",
    "install:all": "npm install"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
